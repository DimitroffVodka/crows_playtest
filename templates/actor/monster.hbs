<form class="crows-monster {{#if defeated}}defeated{{/if}}">

  {{!-- ─────────────────────── Title strip ─────────────────────── --}}
  <header class="m-title">
    <div class="m-portrait-frame">
      <img class="m-portrait" src="{{actor.img}}" alt="{{actor.name}}"
           data-action="editImage" data-edit="img"
           data-tooltip="Click to change portrait">
    </div>
    <input type="text" name="name" value="{{actor.name}}" class="m-name">
    {{#if defeated}}<span class="m-defeated-badge" title="Stamina at 0 — defeated.">DEFEATED</span>{{/if}}
  </header>

  {{#if system.colloquialNames.length}}
    <div class="m-colloquial" title="Common names used by Cornath folk">
      <em>also known as:</em>
      {{#each system.colloquialNames as |n|}}<span class="m-chip">{{n}}</span>{{/each}}
    </div>
  {{/if}}

  {{!-- ─────────────────────── Rulebook stat block ─────────────────────── --}}
  <table class="m-statblock">
    <tbody>
      <tr>
        <td><strong>Size:</strong> <select name="system.size">
          {{#each CROWS.sizes as |s|}}<option value="{{s}}" {{#if (eq s ../system.size)}}selected{{/if}}>{{s}}</option>{{/each}}
        </select></td>
        <td class="m-power-cell">
          <strong>Power:</strong> <input type="number" name="system.power" value="{{system.power}}" min="0">
          <strong>Reactions:</strong> <input type="number" name="system.reactions" value="{{system.reactions}}" min="0" class="m-cur">
        </td>
        <td><strong>Type:</strong> <select name="system.creatureType">
          {{#each CROWS.creatureTypes as |t|}}<option value="{{t}}" {{#if (eq t ../system.creatureType)}}selected{{/if}}>{{t}}</option>{{/each}}
        </select></td>
      </tr>
      <tr>
        <td><strong>Stamina:</strong>
          <input type="number" name="system.stamina.value" value="{{system.stamina.value}}" min="0" class="m-cur">
          /
          <input type="number" name="system.stamina.max" value="{{system.stamina.max}}" min="0" class="m-max">
        </td>
        <td><strong>Speed:</strong> <input type="number" name="system.speed.value" value="{{system.speed.value}}" min="0" class="m-cur"> <em class="m-modes">{{speedDisplay}}</em></td>
        <td><strong>AD:</strong> <input type="number" name="system.ad" value="{{system.ad}}" min="0" class="m-cur"> <span class="m-slots"><strong>Slots:</strong> <input type="number" name="system.slots" value="{{system.slots}}" min="0" class="m-cur"></span></td>
      </tr>
      <tr>
        <td><strong>Agility:</strong> <input type="number" name="system.characteristics.agility" value="{{system.characteristics.agility}}" class="m-cur"></td>
        <td><strong>Mind:</strong> <input type="number" name="system.characteristics.mind" value="{{system.characteristics.mind}}" class="m-cur"></td>
        <td><strong>Strength:</strong> <input type="number" name="system.characteristics.strength" value="{{system.characteristics.strength}}" class="m-cur"></td>
      </tr>
    </tbody>
  </table>


  {{!-- ─────────────────────── Quick combat controls ─────────────────────── --}}
  <div class="m-combat-row">
    <button type="button" data-action="damageSelf" class="m-btn-dmg" title="Apply damage to this monster (with optional piercing)" aria-label="Apply damage">
      <i class="fas fa-burst" aria-hidden="true"></i> Damage
    </button>
    <button type="button" data-action="healSelf" class="m-btn-heal" title="Restore Stamina" aria-label="Apply healing">
      <i class="fas fa-heart" aria-hidden="true"></i> Heal
    </button>
    <div class="m-cond-toggles" role="group" aria-label="Conditions">
      {{#each conditions as |condition|}}
        <button type="button" data-action="toggleCondition" data-condition="{{condition.key}}"
                class="m-cond-btn {{#if condition.active}}on{{/if}}"
                aria-pressed="{{#if condition.active}}true{{else}}false{{/if}}"
                title="{{condition.hint}}">{{condition.label}}</button>
      {{/each}}
    </div>
  </div>

  {{!-- ─────────────────────── Slots ─────────────────────── --}}
  {{#if hasSlots}}
    <section class="m-slots-panel">
      <header class="m-section-header">
        <span>Backpack Slots</span>
        <span class="m-section-meta">{{slotCount}} slots &middot; {{system.wounds}} wounds</span>
      </header>
      {{#if orphanedWoundCount}}
        <div class="m-warning" role="status">{{orphanedWoundCount}} wound(s) are beyond the current slot capacity and remain preserved.</div>
      {{/if}}
      <div class="m-slot-grid">
        {{#each slotCells as |slot|}}
          <button type="button" data-action="toggleWound" data-index="{{slot.index}}"
                  class="m-slot-cell {{#if slot.wounded}}wound{{/if}}"
                  aria-pressed="{{#if slot.wounded}}true{{else}}false{{/if}}"
                  title="Toggle wound in {{slot.label}}">
            <span class="m-slot-label">{{slot.label}}</span>
            <span class="m-slot-state">{{#if slot.wounded}}Wound{{else}}Empty{{/if}}</span>
          </button>
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{!-- ─────────────────────── X/Rest features ─────────────────────── --}}
  <section class="m-xrest">
    <header class="m-section-header">
      <span>X/Rest</span>
      {{#if isGM}}<button type="button" data-action="addXRest" class="m-add-btn" title="Add an X/Rest feature">+ Add</button>{{/if}}
    </header>
    <div class="m-xrest-list">
      {{#each xRestFeatures as |feature|}}
        <div class="m-xrest-row {{#if feature.overused}}overused{{/if}}">
          {{#if ../isGM}}
            <input type="text" name="system.xRest.{{feature.index}}.name" value="{{feature.name}}" class="m-xrest-name" aria-label="Feature name">
            <label class="m-inline-field">Max <input type="number" name="system.xRest.{{feature.index}}.max" value="{{feature.max}}" min="0"></label>
          {{else}}
            <strong class="m-xrest-name-readonly">{{feature.name}}</strong>
            <span class="m-xrest-max">Max {{feature.max}}</span>
          {{/if}}
          <div class="m-use-tracker" aria-label="{{feature.used}} of {{feature.max}} uses spent">
            <button type="button" data-action="adjustXRest" data-index="{{feature.index}}" data-delta="-1"
                    {{#unless feature.canRefund}}disabled{{/unless}} title="Refund one use" aria-label="Refund one use">&minus;</button>
            <span><strong>{{feature.remaining}}</strong> remaining</span>
            <button type="button" data-action="adjustXRest" data-index="{{feature.index}}" data-delta="1"
                    {{#unless feature.canSpend}}disabled{{/unless}} title="Spend one use" aria-label="Spend one use">+</button>
          </div>
          {{#if feature.overused}}<span class="m-overused" role="status">{{feature.overused}} over max</span>{{/if}}
          {{#if ../isGM}}
            <button type="button" data-action="deleteXRest" data-index="{{feature.index}}" class="m-del-btn"
                    aria-label="Delete X/Rest feature {{feature.name}}" title="Delete feature"><i class="fas fa-times" aria-hidden="true"></i></button>
          {{/if}}
        </div>
      {{else}}
        <div class="m-empty">No X/Rest features. {{#if isGM}}Use + Add to define one.{{/if}}</div>
      {{/each}}
    </div>
  </section>

  {{!-- ─────────────────────── Expertises ─────────────────────── --}}
  <section class="m-expertises">
    <header class="m-section-header">
      <span>Expertises</span>
      {{#if isGM}}<button type="button" data-action="addExpertise" class="m-add-btn" title="Add an expertise">+ Add</button>{{/if}}
    </header>
    <div class="m-expertise-list">
      {{#each expertises as |expertise|}}
        <div class="m-expertise-row">
          {{#if ../isGM}}
            <select name="system.expertises.{{expertise.index}}.key" aria-label="Expertise">
              {{#each expertise.choices as |choice|}}
                <option value="{{choice.key}}" {{#if choice.selected}}selected{{/if}}>{{choice.label}}</option>
              {{/each}}
            </select>
          {{else}}
            <strong>{{expertise.label}}</strong>
          {{/if}}
          <label class="m-inline-field">Remaining <input type="number" name="system.expertises.{{expertise.index}}.value" value="{{expertise.value}}" min="0"></label>
          <label class="m-inline-field">Owned <input type="number" name="system.expertises.{{expertise.index}}.max" value="{{expertise.max}}" min="0"></label>
          {{#if ../isGM}}
            <button type="button" data-action="deleteExpertise" data-index="{{expertise.index}}" class="m-del-btn"
                    aria-label="Delete expertise {{expertise.label}}" title="Delete expertise"><i class="fas fa-times" aria-hidden="true"></i></button>
          {{/if}}
        </div>
      {{else}}
        <div class="m-empty">No expertises. {{#if isGM}}Use + Add to define one.{{/if}}</div>
      {{/each}}
    </div>
  </section>

  {{!-- ─────────────────────── Attacks ─────────────────────── --}}
  <section class="m-attacks">
    <header class="m-section-header">
      <span>Attacks</span>
      {{#if isGM}}<button type="button" data-action="addAttack" class="m-add-btn" title="Add a new attack row (GM)">+ Add</button>{{/if}}
    </header>
    <div class="m-attack-grid">
      <div class="m-attack-head">Name</div>
      <div class="m-attack-head">+Hit</div>
      <div class="m-attack-head">Range</div>
      <div class="m-attack-head" title="12-16 damage">T2</div>
      <div class="m-attack-head" title="17+ damage">T3</div>
      <div class="m-attack-head" title="Piercing (bypasses AD)">P</div>
      <div class="m-attack-head"></div>

      {{#each attacks as |atk|}}
        <button type="button" class="m-attack-name" data-action="rollAttack" data-index="{{atk.idx}}" title="Roll {{atk.name}}{{atk.tarSuffix}}">
          {{atk.name}}{{atk.tarSuffix}}
        </button>
        {{#if ../isGM}}
          <input type="number" name="system.attacks.{{atk.idx}}.toHit" value="{{atk.toHit}}" class="m-cur">
          <input type="text" name="system.attacks.{{atk.idx}}.range" value="{{atk.range}}" class="m-range">
          <input type="number" name="system.attacks.{{atk.idx}}.dmgT2" value="{{atk.dmgT2}}" class="m-cur">
          <input type="number" name="system.attacks.{{atk.idx}}.dmgT3" value="{{atk.dmgT3}}" class="m-cur">
          <button type="button" data-action="togglePiercing" data-index="{{atk.idx}}"
                  class="m-p-toggle {{#if atk.piercing}}on{{/if}}"
                  aria-pressed="{{#if atk.piercing}}true{{else}}false{{/if}}"
                  aria-label="Piercing (bypasses AD)"
                  title="Toggle piercing (bypasses AD)">{{#if atk.piercing}}✓{{else}}—{{/if}}</button>
          <button type="button" data-action="deleteAttack" data-index="{{atk.idx}}" class="m-del-btn"
                  aria-label="Delete attack {{atk.name}}" title="Delete attack">
            <i class="fas fa-times" aria-hidden="true"></i>
          </button>
        {{else}}
          <span class="m-cur-readonly">+{{atk.toHit}}</span>
          <span class="m-range-readonly">{{atk.range}}</span>
          <span class="m-cur-readonly">{{atk.dmgT2}}</span>
          <span class="m-cur-readonly">{{atk.dmgT3}}</span>
          <span class="m-p-readonly">{{#if atk.piercing}}P{{else}}—{{/if}}</span>
          <span></span>
        {{/if}}
      {{else}}
        <div class="m-empty">No attacks. {{#if isGM}}Use + Add to define one.{{/if}}</div>
      {{/each}}
    </div>
  </section>

  {{!-- ─────────────────────── Traits ─────────────────────── --}}
  <section class="m-traits">
    <header class="m-section-header">
      <span>Traits</span>
      {{#if isGM}}<button type="button" data-action="addTrait" class="m-add-btn" title="Add a new trait (GM)">+ Add</button>{{/if}}
    </header>
    {{#each traits as |t|}}
      <div class="m-trait">
        <div class="m-trait-head">
          {{#if ../isGM}}
            <input type="text" name="system.traits.{{t.idx}}.name" value="{{t.name}}" class="m-trait-name">
            <input type="text" name="system.traits.{{t.idx}}.uses" value="{{t.uses}}" placeholder="uses…" class="m-trait-uses">
            <button type="button" data-action="deleteTrait" data-index="{{t.idx}}" class="m-del-btn"
                    aria-label="Delete trait {{t.name}}" title="Delete trait">
              <i class="fas fa-times" aria-hidden="true"></i>
            </button>
          {{else}}
            <strong class="m-trait-name-readonly">{{t.name}}</strong>
            {{#if t.uses}}<span class="m-trait-uses-chip">{{t.uses}}</span>{{/if}}
          {{/if}}
        </div>
        {{#if ../isGM}}
          <textarea name="system.traits.{{t.idx}}.effect" rows="2" class="m-trait-effect">{{t.effect}}</textarea>
        {{else}}
          <div class="m-trait-effect-readonly">{{{t.effect}}}</div>
        {{/if}}
      </div>
    {{else}}
      <div class="m-empty">No traits. {{#if isGM}}Use + Add to define one.{{/if}}</div>
    {{/each}}
  </section>

  {{!-- ─────────────────────── GM Notes ─────────────────────── --}}
  {{#if isGM}}
    <section class="m-notes">
      <header class="m-section-header"><span>GM Notes</span></header>
      <textarea name="system.notes" rows="3" placeholder="Tactics, lore, etc.">{{system.notes}}</textarea>
    </section>
  {{/if}}

</form>
