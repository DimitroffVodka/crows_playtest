<div class="crows-crow">
  <header class="cc-header">
    <div class="cc-portrait-frame">
      <img class="cc-portrait" src="{{actor.img}}" alt="{{actor.name}}"
           data-action="editImage" data-edit="img"
           data-tooltip="{{localize 'CROWS.Sheet.Crow.tooltip.changePortrait'}}">
    </div>
    <div class="cc-id">
      <div class="cc-field">
        <label>{{localize "CROWS.Sheet.Crow.name"}}</label>
        <input type="text" name="name" value="{{actor.name}}">
      </div>
      <div class="cc-field">
        <label>{{localize "CROWS.Sheet.Crow.background"}}</label>
        <input type="text" name="system.background" value="{{system.background}}">
      </div>
      <div class="cc-field feature">
        <label>{{localize "CROWS.Sheet.Crow.feature"}}</label>
        <input type="text" name="system.details.feature" value="{{system.details.feature}}">
      </div>
    </div>
    <div class="cc-xp">
      <div class="cc-xp-row">
        <div class="cc-xp-cell">
          <label>{{localize "CROWS.Sheet.Crow.xp.spendable"}}</label>
          <input type="number" name="system.xp.spendable" value="{{system.xp.spendable}}">
        </div>
        <div class="cc-xp-cell">
          <label>{{localize "CROWS.Sheet.Crow.xp.next"}}</label>
          <span class="cc-xp-target" data-tooltip="{{localize 'CROWS.Sheet.Crow.xp.nextHint'}}">
            {{nextAdvancement.expertise}} / {{nextAdvancement.char}}
          </span>
        </div>
      </div>
      <div class="cc-xp-row">
        <div class="cc-xp-cell">
          <label>{{localize "CROWS.Sheet.Crow.xp.total"}}</label>
          <input type="number" name="system.xp.txp" value="{{system.xp.txp}}">
        </div>
      </div>
    </div>
  </header>

  <section class="cc-stats">
    <div class="cc-stat-box clickable" data-action="rollChar" data-characteristic="strength"
         data-tooltip="{{localize 'CROWS.Sheet.Crow.tooltip.rollStrength'}}">
      <div class="cc-stat-label">{{localize "CROWS.Characteristic.strength"}}</div>
      <input type="number" class="cc-stat-value" name="system.characteristics.strength.value" value="{{system.characteristics.strength.value}}">
    </div>
    <div class="cc-stat-box clickable" data-action="rollChar" data-characteristic="agility"
         data-tooltip="{{localize 'CROWS.Sheet.Crow.tooltip.rollAgility'}}">
      <div class="cc-stat-label">{{localize "CROWS.Characteristic.agility"}}</div>
      <input type="number" class="cc-stat-value" name="system.characteristics.agility.value" value="{{system.characteristics.agility.value}}">
    </div>
    <div class="cc-stat-box clickable" data-action="rollChar" data-characteristic="mind"
         data-tooltip="{{localize 'CROWS.Sheet.Crow.tooltip.rollMind'}}">
      <div class="cc-stat-label">{{localize "CROWS.Characteristic.mind"}}</div>
      <input type="number" class="cc-stat-value" name="system.characteristics.mind.value" value="{{system.characteristics.mind.value}}">
    </div>
    <div class="cc-stat-box">
      <div class="cc-stat-label">{{localize "CROWS.Sheet.Crow.stamina"}}</div>
      <div class="cc-stat-pair">
        <input type="number" name="system.stamina.value" value="{{system.stamina.value}}">
        <span class="sep">/</span>
        <input type="number" name="system.stamina.max" value="{{system.stamina.max}}">
      </div>
    </div>
    <div class="cc-stat-box">
      <div class="cc-stat-label">{{localize "CROWS.Sheet.Crow.ad"}}</div>
      <div class="cc-stat-value cc-ad-derived">{{system.ad}}</div>
    </div>
  </section>

  <section class="cc-substats">
    <div class="cc-mini-box" data-tooltip="{{speedNote}}">
      <div class="cc-mini-value">
        {{#if speedNote}}
          <span class="cc-speed-effective">{{effectiveSpeed}}</span><span class="cc-speed-base">/{{system.speed}}</span>
        {{else}}
          <input type="number" name="system.speed" value="{{system.speed}}">
        {{/if}}
      </div>
      <div class="cc-mini-label">{{localize "CROWS.Sheet.Crow.speed"}}{{#if speedNote}} <em>({{speedNote}})</em>{{/if}}</div>
    </div>
    <div class="cc-mini-box">
      <div class="cc-mini-value">{{shift}}</div>
      <div class="cc-mini-label">{{localize "CROWS.Sheet.Crow.shift"}}</div>
    </div>
    <div class="cc-conditions cc-condition-panel">
      <div class="cc-conditions-title">{{localize "CROWS.Sheet.Crow.conditions"}}</div>
      <div class="cc-conditions-row cc-condition-grid">
        {{#each conditions as |condition|}}
          <label class="cc-cond-cell cc-condition-toggle" data-tooltip="{{condition.hint}}">
            <span class="cc-cond-label">{{condition.label}}</span>
            <input type="checkbox" name="system.conditions.{{condition.key}}" {{#if condition.active}}checked{{/if}}
                   aria-label="{{condition.label}}">
          </label>
        {{/each}}
      </div>
    </div>
    <div class="cc-time">
      <div class="cc-conditions-title">{{localize "CROWS.Sheet.Crow.time"}}</div>
      <div class="cc-time-row">
        <div class="cc-time-cell">
          <div class="cc-cond-label">{{localize "CROWS.Sheet.Crow.dungeonTurn"}}</div>
          <div class="cc-net">{{dtCount}}</div>
        </div>
        <button type="button" data-action="takeRest" data-tooltip="{{localize 'CROWS.Sheet.Crow.tooltip.rest'}}">
          {{localize "CROWS.Sheet.Crow.rest"}}
        </button>
        {{#if isGM}}
          <button type="button" data-action="endDt" data-tooltip="{{localize 'CROWS.Sheet.Crow.tooltip.endTurn'}}">
            {{localize "CROWS.Sheet.Crow.endTurn"}}
          </button>
          <button type="button" data-action="encounterCheck" data-tooltip="{{localize 'CROWS.Sheet.Crow.tooltip.encounter'}}">
            {{localize "CROWS.Sheet.Crow.encounter"}}
          </button>
        {{/if}}
      </div>
      {{#if preparedTask}}
        <div class="cc-prepared-task" data-tooltip="{{localize 'CROWS.Sheet.Crow.prepared.hint'}}">
          <button type="button" data-action="rollPreparedTask">
            <strong>{{localize "CROWS.Sheet.Crow.prepared.label"}}</strong>
            {{localize "CROWS.Sheet.Crow.prepared.bonus" bonus=preparedTask.bonus task=preparedTask.task}}
          </button>
          <span class="cc-prepared-when">{{localize "CROWS.Sheet.Crow.prepared.setOn" turn=preparedTask.setOn}}</span>
        </div>
      {{/if}}
      {{#if activeBoonCard}}
        <div class="cc-active-boon" data-tooltip="{{localize 'CROWS.Sheet.Crow.crypt.activeHint'}}">
          <strong>{{activeBoonCard.label}}</strong>
          {{#if activeBoonCard.source}}<span class="cb-src">{{localize "CROWS.Sheet.Crow.via" source=activeBoonCard.source}}</span>{{/if}}
          {{#if (gte activeBoonCard.usesLeft 2)}}<span class="cb-uses">{{localize "CROWS.Sheet.Crow.uses" count=activeBoonCard.usesLeft}}</span>{{/if}}
          <div class="cb-summary">{{activeBoonCard.summary}}</div>
        </div>
      {{/if}}
      {{#if inMiasma}}
        <div class="cc-mini-flag" data-tooltip="{{localize 'CROWS.Sheet.Crow.miasma.activeHint'}}">
          <span class="cc-miasma-badge in-miasma" role="status">{{localize "CROWS.Sheet.Crow.miasma.in"}}</span>
          {{#if miasmaEffects.length}}<em>{{localize "CROWS.Sheet.Crow.miasma.effectCount" count=miasmaEffects.length}}</em>{{/if}}
        </div>
      {{/if}}
      {{#if miasmaPermanentNPC}}
        <div class="cc-mini-flag"><span class="cc-miasma-badge permanent-npc">{{localize "CROWS.Sheet.Crow.miasma.permanentNpc"}}</span></div>
      {{/if}}
    </div>
  </section>

  <nav class="cc-tabs" role="tablist" aria-label="{{localize 'CROWS.Sheet.Crow.tabsLabel'}}">
    {{#each tabs as |tab|}}
      <button type="button" role="tab" data-action="switchTab" data-tab="{{tab.id}}"
              id="tab-{{tab.id}}" aria-controls="panel-{{tab.id}}"
              aria-selected="{{#if (eq tab.id ../activeTab)}}true{{else}}false{{/if}}"
              tabindex="{{#if (eq tab.id ../activeTab)}}0{{else}}-1{{/if}}"
              class="{{#if (eq tab.id ../activeTab)}}active{{/if}}">{{tab.label}}</button>
    {{/each}}
  </nav>

  <section class="cc-tab cc-main {{#if (eq activeTab 'main')}}active{{/if}}"
           role="tabpanel" id="panel-main" aria-labelledby="tab-main"
           {{#unless (eq activeTab 'main')}}hidden{{/unless}}>
    <div class="cc-expertise-panel">
      <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.expertise.title"}}</div>
      <div class="cc-expertise-hint">{{localize "CROWS.Sheet.Crow.expertise.hint"}}</div>
      {{#if expertiseOverBudget}}
        <div class="cc-expertise-warning" role="status">{{expertiseOverBudgetLabel}}</div>
      {{/if}}
      <div class="cc-expertise-groups">
        {{#each expertiseGroups as |group|}}
          <div class="cc-expertise-group">
            <div class="cc-expertise-group-title" data-tooltip="{{group.hint}}">{{group.label}}</div>
            {{#each group.entries as |entry|}}
              <div class="cc-expertise-row" data-tooltip="{{entry.hint}}">
                <span class="cc-expertise-name">{{entry.label}}</span>
                <span class="cc-expertise-pool" aria-label="{{localize 'CROWS.Sheet.Crow.expertise.poolLabel' expertise=entry.label value=entry.value max=entry.max}}">
                  {{entry.value}} / {{entry.max}}
                </span>
                <button type="button" class="cc-expertise-spend" data-action="spendExpertiseUse" data-expertise="{{entry.key}}"
                        {{#unless entry.canSpend}}disabled{{/unless}}
                        data-tooltip="{{localize 'CROWS.Sheet.Crow.expertise.spendHint' expertise=entry.label}}">
                  {{localize "CROWS.Sheet.Crow.expertise.spend"}}
                </button>
                {{#if entry.overCap}}<span class="cc-expertise-warning">{{localize "CROWS.Sheet.Crow.expertise.overCap" count=entry.overCap}}</span>{{/if}}
                {{#if entry.overMax}}<span class="cc-expertise-warning">{{localize "CROWS.Sheet.Crow.expertise.overMax" count=entry.overMax}}</span>{{/if}}
              </div>
            {{/each}}
          </div>
        {{/each}}
      </div>
    </div>

    <div class="cc-perks">
      <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.traits.title"}}</div>
      <div class="cc-perks-list">
        {{#if perks.length}}
          {{#each perks as |trait|}}
            <div class="cc-perk" data-action="openItem" data-item-id="{{trait.id}}">
              <img class="cc-item-icon sm" src="{{trait.img}}" alt="">
              <span class="cc-perk-name">{{trait.name}}</span>
              <span class="cc-perk-meta">
                {{trait.treeLabel}} · {{localize "CROWS.Sheet.Crow.tierShort" tier=trait.tier}}
                {{#if trait.usePool}}
                  · {{localize "CROWS.Sheet.Crow.traits.pool" remaining=trait.usePool.remaining max=trait.usePool.max}}
                  {{#if trait.usePool.overused}} · {{localize "CROWS.Sheet.Crow.traits.overused" count=trait.usePool.overused}}{{/if}}
                {{/if}}
              </span>
            </div>
          {{/each}}
        {{else}}
          <p class="cc-empty">{{localize "CROWS.Sheet.Crow.traits.empty"}}</p>
        {{/if}}
      </div>
    </div>
  </section>

  <section class="cc-tab cc-equipment {{#if (eq activeTab 'equipment')}}active{{/if}}"
           role="tabpanel" id="panel-equipment" aria-labelledby="tab-equipment"
           {{#unless (eq activeTab 'equipment')}}hidden{{/unless}}>
    <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.equipment.carry"}}</div>
    <div class="cc-equip-grid">
      {{#each inventory.hand.slots as |slot|}}
        <div class="cc-slot {{#if slot.filled}}filled{{/if}}" data-container="{{slot.container}}" data-index="{{slot.index}}">
          <div class="cc-slot-header">{{slot.label}}</div>
          {{#if slot.isContinuation}}
            <div class="cc-slot-empty cc-slot-continuation">{{localize "CROWS.Sheet.Crow.inventory.continues" item=slot.continuationName}}</div>
          {{else}}
            {{#each slot.cards as |card|}}
              <div class="cc-card draggable" draggable="true" data-item-id="{{card.id}}">
                <div class="cc-card-hd" data-action="openItem" data-item-id="{{card.id}}">
                  <span class="cc-sigil"><img class="cc-sigil-img" src="{{card.img}}" alt=""></span>
                  <span class="cc-card-name">{{card.name}}</span>
                  <span class="cc-card-kw">{{card.typeLabel}}{{#if card.stack}} · {{card.stack}}{{/if}}</span>
                </div>
                <button type="button" class="cc-card-remove" data-action="removeItem" data-item-id="{{card.id}}"
                        aria-label="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}"
                        data-tooltip="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}">&times;</button>
                <div class="cc-card-body">
                  {{#each card.summary.lines as |line|}}<div class="cc-card-line">{{line}}</div>{{/each}}
                  {{#if (eq card.type "weapon")}}
                    <button type="button" class="cc-attack-btn" data-action="attackWithWeapon" data-item-id="{{card.id}}">{{localize "CROWS.Sheet.Crow.attack"}}</button>
                  {{/if}}
                  {{#if card.cost}}<div class="cc-card-cost">{{localize "CROWS.Sheet.Crow.currencyAmount" amount=card.cost}}</div>{{/if}}
                </div>
              </div>
            {{/each}}
            {{#unless slot.cards.length}}<div class="cc-slot-empty">{{localize "CROWS.Sheet.Crow.inventory.empty"}}</div>{{/unless}}
          {{/if}}
        </div>
      {{/each}}
    </div>

    <div class="cc-belt-panel">
      <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.equipment.belt"}}</div>
      <div class="cc-belt-grid">
        {{#each inventory.belt.slots as |slot|}}
          <div class="cc-slot {{#if slot.filled}}filled{{/if}}" data-container="{{slot.container}}" data-index="{{slot.index}}">
            <div class="cc-slot-header">{{slot.label}}</div>
            {{#if slot.isContinuation}}
              <div class="cc-slot-empty cc-slot-continuation">{{localize "CROWS.Sheet.Crow.inventory.continues" item=slot.continuationName}}</div>
            {{else}}
              {{#each slot.cards as |card|}}
                <div class="cc-card draggable" draggable="true" data-item-id="{{card.id}}">
                  <div class="cc-card-hd" data-action="openItem" data-item-id="{{card.id}}">
                    <span class="cc-sigil"><img class="cc-sigil-img" src="{{card.img}}" alt=""></span>
                    <span class="cc-card-name">{{card.name}}</span>
                    <span class="cc-card-kw">{{card.typeLabel}}{{#if card.stack}} · {{card.stack}}{{/if}}</span>
                  </div>
                  <button type="button" class="cc-card-remove" data-action="removeItem" data-item-id="{{card.id}}"
                          aria-label="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}" data-tooltip="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}">&times;</button>
                  <div class="cc-card-body">
                    {{#each card.summary.lines as |line|}}<div class="cc-card-line">{{line}}</div>{{/each}}
                    {{#if (eq card.type "weapon")}}<button type="button" class="cc-attack-btn" data-action="attackWithWeapon" data-item-id="{{card.id}}">{{localize "CROWS.Sheet.Crow.attack"}}</button>{{/if}}
                    {{#if card.cost}}<div class="cc-card-cost">{{localize "CROWS.Sheet.Crow.currencyAmount" amount=card.cost}}</div>{{/if}}
                  </div>
                </div>
              {{/each}}
              {{#unless slot.cards.length}}<div class="cc-slot-empty">{{localize "CROWS.Sheet.Crow.inventory.empty"}}</div>{{/unless}}
            {{/if}}
          </div>
        {{/each}}
      </div>
    </div>

    <div class="cc-magic-panel">
      <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.equipment.magic"}}</div>
      {{#if magicOverload}}<div class="cc-inventory-warning" role="status">{{localize "CROWS.Warn.magicSlotOverload"}}</div>{{/if}}
      <div class="cc-magic-grid">
        {{#each inventory.magic as |group|}}
          {{#each group.slots as |slot|}}
            <div class="cc-slot {{#if slot.filled}}filled{{/if}}" data-container="{{slot.container}}" data-index="{{slot.index}}">
              <div class="cc-slot-header">{{group.label}}</div>
              {{#each slot.cards as |card|}}
                <div class="cc-card draggable" draggable="true" data-item-id="{{card.id}}">
                  <div class="cc-card-hd" data-action="openItem" data-item-id="{{card.id}}">
                    <span class="cc-sigil"><img class="cc-sigil-img" src="{{card.img}}" alt=""></span>
                    <span class="cc-card-name">{{card.name}}</span>
                    <span class="cc-card-kw">{{card.typeLabel}}</span>
                  </div>
                  <button type="button" class="cc-card-remove" data-action="removeItem" data-item-id="{{card.id}}"
                          aria-label="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}" data-tooltip="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}">&times;</button>
                  <div class="cc-card-body">
                    {{#each card.summary.lines as |line|}}<div class="cc-card-line">{{line}}</div>{{/each}}
                  </div>
                </div>
              {{/each}}
              {{#unless slot.cards.length}}<div class="cc-slot-empty">{{localize "CROWS.Sheet.Crow.inventory.empty"}}</div>{{/unless}}
            </div>
          {{/each}}
        {{/each}}
      </div>
    </div>
  </section>

  <section class="cc-tab cc-inventory {{#if (eq activeTab 'inventory')}}active{{/if}}"
           role="tabpanel" id="panel-inventory" aria-labelledby="tab-inventory"
           {{#unless (eq activeTab 'inventory')}}hidden{{/unless}}>
    <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.inventory.backpack"}}</div>
    <div class="cc-wounds-controls">
      <span>{{localize "CROWS.Sheet.Crow.wounds.summary" count=system.wounds capacity=inventory.backpack.capacity}}</span>
      <span>{{localize "CROWS.Sheet.Crow.wounds.choose"}}</span>
    </div>
    {{#if orphanedWoundCount}}<div class="cc-inventory-warning" role="status">{{orphanedWoundsLabel}}</div>{{/if}}
    <div class="cc-inv-grid">
      {{#each inventory.backpack.slots as |slot|}}
        <div class="cc-slot cc-inv-slot {{#if slot.filled}}filled{{/if}} {{#if slot.wound}}wound{{/if}}"
             data-container="{{slot.container}}" data-index="{{slot.index}}">
          <div class="cc-slot-header">
            <span>{{slot.label}}</span>
            <label class="cc-wound-check cc-wound-toggle">
              <span>{{localize "CROWS.Sheet.Crow.wounds.wound"}}</span>
              <input type="checkbox" data-action="toggleWound" data-index="{{slot.index}}" {{#if slot.wound}}checked{{/if}}>
            </label>
          </div>
          {{#if slot.wound}}<div class="cc-slot-wound cc-wound-marker">{{localize "CROWS.Sheet.Crow.wounds.marker"}}</div>{{/if}}
          {{#if slot.isContinuation}}
            <div class="cc-slot-empty cc-slot-continuation">{{localize "CROWS.Sheet.Crow.inventory.continues" item=slot.continuationName}}</div>
          {{else}}
            {{#each slot.cards as |card|}}
              <div class="cc-card draggable" draggable="true" data-item-id="{{card.id}}">
                <div class="cc-card-hd" data-action="openItem" data-item-id="{{card.id}}">
                  <span class="cc-sigil"><img class="cc-sigil-img" src="{{card.img}}" alt=""></span>
                  <span class="cc-card-name">{{card.name}}</span>
                  <span class="cc-card-kw">{{card.typeLabel}}{{#if card.stack}} · {{card.stack}}{{/if}}</span>
                </div>
                <button type="button" class="cc-card-remove" data-action="removeItem" data-item-id="{{card.id}}"
                        aria-label="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}"
                        data-tooltip="{{localize "CROWS.Sheet.Crow.inventory.remove" item=card.name}}">&times;</button>
                <div class="cc-card-body">
                  {{#each card.summary.lines as |line|}}<div class="cc-card-line">{{line}}</div>{{/each}}
                  {{#if card.cost}}<div class="cc-card-cost">{{localize "CROWS.Sheet.Crow.currencyAmount" amount=card.cost}}</div>{{/if}}
                </div>
              </div>
            {{/each}}
            {{#unless slot.cards.length}}{{#unless slot.wound}}<div class="cc-slot-empty">{{localize "CROWS.Sheet.Crow.inventory.empty"}}</div>{{/unless}}{{/unless}}
          {{/if}}
        </div>
      {{/each}}
    </div>

    <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.inventory.coin"}}</div>
    <div class="cc-wounds-controls">
      <span>{{localize "CROWS.Sheet.Crow.inventory.looseCoin" amount=inventory.coin.loose slots=inventory.coin.looseSlots}}</span>
      <span>{{localize "CROWS.Sheet.Crow.inventory.purseCoin" held=inventory.coin.purseHeld capacity=inventory.coin.purseCapacity}}</span>
      <span>{{localize "CROWS.Sheet.Crow.inventory.totalCoin" amount=inventory.coin.totalHeld}}</span>
      {{#if inventory.coin.overflow}}<span class="cc-inventory-warning">{{localize "CROWS.Sheet.Crow.inventory.coinOverflow" amount=inventory.coin.overflow}}</span>{{/if}}
    </div>

    {{#if inventory.unplaced.length}}
      <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.inventory.unplaced"}}</div>
      <div class="cc-inventory-warning">{{localize "CROWS.Sheet.Crow.inventory.unplacedHint"}}</div>
      <div class="cc-equip-grid">
        {{#each inventory.unplaced as |entry|}}
          <div class="cc-slot filled">
            <div class="cc-slot-header">{{entry.reasonLabel}}</div>
            {{#if entry.card}}
              <div class="cc-card draggable" draggable="true" data-item-id="{{entry.card.id}}">
                <div class="cc-card-hd" data-action="openItem" data-item-id="{{entry.card.id}}">
                  <span class="cc-sigil"><img class="cc-sigil-img" src="{{entry.card.img}}" alt=""></span>
                  <span class="cc-card-name">{{entry.card.name}}</span>
                  <span class="cc-card-kw">{{entry.card.typeLabel}}</span>
                </div>
                <button type="button" class="cc-card-remove" data-action="removeItem" data-item-id="{{entry.card.id}}"
                        aria-label="{{localize "CROWS.Sheet.Crow.inventory.remove" item=entry.card.name}}" data-tooltip="{{localize "CROWS.Sheet.Crow.inventory.remove" item=entry.card.name}}">&times;</button>
                <div class="cc-card-body">{{#each entry.card.summary.lines as |line|}}<div class="cc-card-line">{{line}}</div>{{/each}}</div>
              </div>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{/if}}

    {{#if inventory.weightless.length}}
      <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.inventory.weightless"}}</div>
      <div class="cc-perks-list">
        {{#each inventory.weightless as |card|}}
          <div class="cc-perk draggable" draggable="true" data-action="openItem" data-item-id="{{card.id}}">
            <img class="cc-item-icon sm" src="{{card.img}}" alt=""><span class="cc-perk-name">{{card.name}}</span><span class="cc-perk-meta">{{card.typeLabel}}</span>
          </div>
        {{/each}}
      </div>
    {{/if}}
  </section>

  <section class="cc-tab cc-pets {{#if (eq activeTab 'pets')}}active{{/if}}"
           role="tabpanel" id="panel-pets" aria-labelledby="tab-pets"
           {{#unless (eq activeTab 'pets')}}hidden{{/unless}}>
    <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.pets.title"}}</div>
    <p class="cc-pets-hint">{{localize "CROWS.Sheet.Crow.pets.hint"}}</p>
    {{#if pets.animals.length}}
      <div class="cc-pet-list">
        {{#each pets.animals as |pet|}}
          <article class="cc-pet-card cc-pet-{{pet.statusKey}}">
            <header class="cc-pet-header">
              {{#if pet.img}}<img class="cc-item-icon" src="{{pet.img}}" alt="">{{/if}}
              <div class="cc-pet-identity">
                <strong>{{pet.name}}</strong>
                <span class="cc-pet-meta">{{pet.sizeLabel}} · {{localize "CROWS.Sheet.Crow.pets.power" power=pet.power}}</span>
              </div>
              <span class="cc-pet-status">{{pet.statusLabel}}</span>
            </header>
            {{#if pet.ownerName}}
              <div class="cc-pet-owner">{{localize "CROWS.Sheet.Crow.pets.owner" owner=pet.ownerName}}</div>
            {{/if}}
            <div class="cc-pet-slots">
              <span>{{localize "CROWS.Sheet.Crow.pets.slots" occupied=pet.slots.occupied capacity=pet.slots.capacity free=pet.slots.free}}</span>
              {{#if pet.slots.hasCapacity}}
                <div class="cc-pet-capacity" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{pet.slots.percent}}">
                  <div class="cc-pet-capacity-fill" style="width: {{pet.slots.percent}}%"></div>
                </div>
              {{else}}
                <span class="cc-pet-no-slots">{{localize "CROWS.Sheet.Crow.pets.noSlots"}}</span>
              {{/if}}
            </div>
            {{#if pets.canAct}}
              {{#if pet.actions.visible}}
                <div class="cc-pet-actions">
                  <button type="button" class="cc-pet-action" data-action="tamePet" data-pet-id="{{pet.id}}"
                          {{#unless pet.actions.tame.enabled}}disabled{{/unless}}
                          data-tooltip="{{pet.actions.tame.reasonLabel}}">
                    {{localize "CROWS.Sheet.Crow.pets.tame"}}
                  </button>
                  <button type="button" class="cc-pet-action" data-action="commandPet" data-pet-id="{{pet.id}}"
                          {{#unless pet.actions.command.enabled}}disabled{{/unless}}
                          data-tooltip="{{pet.actions.command.reasonLabel}}">
                    {{localize "CROWS.Sheet.Crow.pets.command"}}
                  </button>
                  <button type="button" class="cc-pet-action cc-pet-command-test" data-action="testCommandPet" data-pet-id="{{pet.id}}"
                          {{#unless pet.actions.commandTest.enabled}}disabled{{/unless}}
                          data-tooltip="{{pet.actions.commandTest.reasonLabel}}">
                    {{localize "CROWS.Sheet.Crow.pets.commandTest"}}
                  </button>
                </div>
              {{/if}}
            {{/if}}
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="cc-empty">{{localize "CROWS.Sheet.Crow.pets.empty"}}</p>
    {{/if}}
  </section>

  <section class="cc-tab cc-advancement {{#if (eq activeTab 'advancement')}}active{{/if}}"
           role="tabpanel" id="panel-advancement" aria-labelledby="tab-advancement"
           {{#unless (eq activeTab 'advancement')}}hidden{{/unless}}>
    <div class="cc-adv-header">
      <div class="cc-adv-stat"><span class="cc-adv-label">{{localize "CROWS.Sheet.Crow.xp.total"}}</span><strong>{{system.xp.txp}}</strong></div>
      <div class="cc-adv-stat"><span class="cc-adv-label">{{localize "CROWS.Sheet.Crow.xp.spendable"}}</span><strong>{{system.xp.spendable}}</strong></div>
      <div class="cc-adv-stat"><span class="cc-adv-label">{{localize "CROWS.Sheet.Crow.advancement.nextExpertise"}}</span><strong>{{advancement.next.expertise}}</strong></div>
      <div class="cc-adv-stat"><span class="cc-adv-label">{{localize "CROWS.Sheet.Crow.advancement.nextCharacteristic"}}</span><strong>{{advancement.next.char}}</strong></div>
      <div class="cc-adv-stat">
        <span class="cc-adv-label">{{localize "CROWS.Sheet.Crow.advancement.expertiseTrack"}}</span>
        <strong>{{advancement.available.earned.expertise}}</strong>
        {{#if advancement.available.expertise}}<span class="cc-adv-pending">{{localize "CROWS.Sheet.Crow.advancement.unspent" count=advancement.available.expertise}}</span>{{/if}}
      </div>
      <div class="cc-adv-stat">
        <span class="cc-adv-label">{{localize "CROWS.Sheet.Crow.advancement.characteristicTrack"}}</span>
        <strong>{{advancement.available.earned.char}}</strong>
        {{#if advancement.available.char}}<span class="cc-adv-pending">{{localize "CROWS.Sheet.Crow.advancement.unspent" count=advancement.available.char}}</span>{{/if}}
      </div>
      <button type="button" data-action="spendExpertiseBonus" class="cc-adv-spend-btn"
              {{#unless advancement.canSpendExpertise}}disabled{{/unless}} data-tooltip="{{advancement.expertiseDisabledReason}}">
        {{localize "CROWS.Sheet.Crow.advancement.claimExpertise"}}
      </button>
      <button type="button" data-action="spendCharBonus" class="cc-adv-spend-btn"
              {{#unless advancement.canSpendCharacteristic}}disabled{{/unless}} data-tooltip="{{advancement.characteristicDisabledReason}}">
        {{localize "CROWS.Sheet.Crow.advancement.claimCharacteristic"}}
      </button>
      {{#if isGM}}
        <button type="button" data-action="grantXp" data-amount="100" class="cc-adv-grant">{{localize "CROWS.Sheet.Crow.advancement.grant" amount=100}}</button>
        <button type="button" data-action="grantXp" data-amount="500" class="cc-adv-grant">{{localize "CROWS.Sheet.Crow.advancement.grant" amount=500}}</button>
        <button type="button" data-action="grantXp" data-amount="1000" class="cc-adv-grant">{{localize "CROWS.Sheet.Crow.advancement.grant" amount=1000}}</button>
      {{/if}}
    </div>

    <div class="cc-tree-picker">
      {{#each treeList as |tree|}}
        <button type="button" data-action="selectTree" data-tree="{{tree.key}}"
                class="cc-tree-chip {{#if (eq tree.key ../selectedTree)}}active{{/if}}">{{tree.label}}</button>
      {{/each}}
    </div>
    {{#if treeGrid}}
      <div class="cc-trait-grid">
        {{#each treeGrid as |row|}}
          <div class="cc-trait-row">
            <div class="cc-tier-label">
              <div class="ct-tier">{{localize "CROWS.Sheet.Crow.tier" tier=row.tier}}</div>
              <div class="ct-cost">{{localize "CROWS.Sheet.Crow.xp.amount" amount=row.cost}}</div>
            </div>
            {{#each row.cells as |cell|}}
              {{#if cell}}
                <div class="cc-trait-cell {{#if cell.owned}}owned{{else if cell.enabled}}buyable{{else}}locked{{/if}}"
                     {{#if cell.enabled}}data-action="buyTrait" data-trait-id="{{cell.id}}"{{/if}} data-tooltip="{{cell.reason}}">
                  <div class="ct-name">{{cell.name}}</div>
                  <div class="ct-status">
                    {{#if cell.owned}}<span class="ct-owned">{{localize "CROWS.Sheet.Crow.advancement.owned"}}</span>
                    {{else if cell.enabled}}<span class="ct-buy">{{localize "CROWS.Sheet.Crow.advancement.buy" cost=cell.cost}}</span>
                    {{else}}<span class="ct-locked">{{localize "CROWS.Sheet.Crow.advancement.locked"}}</span>{{/if}}
                  </div>
                </div>
              {{else}}
                <div class="cc-trait-cell empty"><em>—</em></div>
              {{/if}}
            {{/each}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="cc-empty">{{localize "CROWS.Sheet.Crow.advancement.noTraits"}}</p>
    {{/if}}
  </section>

  <section class="cc-tab cc-downtime {{#if (eq activeTab 'downtime')}}active{{/if}}"
           role="tabpanel" id="panel-downtime" aria-labelledby="tab-downtime"
           {{#unless (eq activeTab 'downtime')}}hidden{{/unless}}>
    {{#if village}}
      <div class="dt-panel dt-village">
        <header class="dt-panel-header">
          <strong>{{localize "CROWS.Sheet.Crow.village.title" name=village.name}}</strong>
          <span class="dt-village-stat">{{localize "CROWS.Sheet.Crow.village.prosperity" value=village.prosperity}}</span>
          <span class="dt-village-stat">{{localize "CROWS.Sheet.Crow.village.cycle" value=village.cycle}}</span>
          <button type="button" data-action="openVillage" data-tooltip="{{localize 'CROWS.Sheet.Crow.village.manageHint'}}">{{localize "CROWS.Sheet.Crow.manage"}}</button>
        </header>
      </div>
    {{/if}}

    <div class="dt-panel dt-crypt">
      <header class="dt-panel-header">
        <strong>{{localize "CROWS.Sheet.Crow.crypt.title"}}</strong>
        <span class="cc-crypt-label">{{localize "CROWS.Sheet.Crow.levelShort" level=cryptLevel}}</span>
        <button type="button" data-action="cryptPray" {{#if alreadyPrayedThisCycle}}disabled{{/if}}
                data-tooltip="{{#if alreadyPrayedThisCycle}}{{localize 'CROWS.Sheet.Crow.crypt.prayed'}}{{else}}{{localize 'CROWS.Sheet.Crow.crypt.prayHint'}}{{/if}}">
          {{localize "CROWS.Sheet.Crow.crypt.pray"}}
        </button>
        {{#if activeBoonCard}}<button type="button" data-action="cryptExpend">{{localize "CROWS.Sheet.Crow.crypt.expend"}}</button>{{/if}}
        {{#if isGM}}
          <button type="button" data-action="cryptInter">{{localize "CROWS.Sheet.Crow.crypt.inter"}}</button>
          <button type="button" data-action="cryptBumpCycle">{{localize "CROWS.Sheet.Crow.crypt.advanceCycle"}}</button>
        {{/if}}
      </header>
      {{#if activeBoonCard}}
        <div class="cc-active-boon">
          <strong>{{activeBoonCard.label}}</strong>
          {{#if activeBoonCard.source}}<span class="cb-src">{{localize "CROWS.Sheet.Crow.via" source=activeBoonCard.source}}</span>{{/if}}
          {{#if (gte activeBoonCard.usesLeft 2)}}<span class="cb-uses">{{localize "CROWS.Sheet.Crow.uses" count=activeBoonCard.usesLeft}}</span>{{/if}}
          <div class="cb-summary">{{activeBoonCard.summary}}</div>
        </div>
      {{else}}
        <p class="cc-empty">{{#if cryptInterments.length}}{{localize "CROWS.Sheet.Crow.crypt.emptyWithGraves"}}{{else}}{{localize "CROWS.Sheet.Crow.crypt.empty"}}{{/if}}</p>
      {{/if}}
    </div>

    <div class="dt-panel dt-miasma">
      <header class="dt-panel-header">
        <strong>{{localize "CROWS.Sheet.Crow.miasma.title"}}</strong>
        {{#if inMiasma}}
          <span class="cc-miasma-badge in-miasma">{{localize "CROWS.Sheet.Crow.miasma.in"}}</span>
        {{else}}
          <span class="cc-miasma-badge clear">{{localize "CROWS.Sheet.Crow.miasma.out"}}</span>
        {{/if}}
        {{#if isGM}}<button type="button" data-action="toggleMiasma">{{localize "CROWS.Sheet.Crow.miasma.toggle"}}</button>{{/if}}
        <button type="button" data-action="rollMiasmaResist">{{localize "CROWS.Sheet.Crow.miasma.resist"}}</button>
        {{#if miasmaEffects.length}}<button type="button" data-action="clearMiasmaSelf">{{localize "CROWS.Sheet.Crow.miasma.clear"}}</button>{{/if}}
        {{#if miasmaPermanentNPC}}<span class="cc-miasma-badge permanent-npc">{{localize "CROWS.Sheet.Crow.miasma.permanentNpc"}}</span>{{/if}}
      </header>
      {{#if miasmaEffects.length}}
        <ul class="cc-miasma-effects">
          {{#each miasmaEffects as |effect|}}
            <li><strong>{{effect.label}}</strong> <span class="me-bucket">{{localize "CROWS.Sheet.Crow.miasma.bucket" bucket=effect.bucket}}</span> — {{effect.text}}</li>
          {{/each}}
        </ul>
      {{else}}
        <p class="cc-empty">{{#if inMiasma}}{{localize "CROWS.Sheet.Crow.miasma.emptyIn"}}{{else}}{{localize "CROWS.Sheet.Crow.miasma.emptyOut"}}{{/if}}</p>
      {{/if}}
    </div>

    <div class="dt-panel dt-crafting">
      <header class="dt-panel-header">
        <strong>{{localize "CROWS.Sheet.Crow.crafting.title"}}</strong>
        <button type="button" data-action="craftStart">{{localize "CROWS.Sheet.Crow.crafting.start"}}</button>
      </header>
      {{#if craftingProjects.length}}
        <ul class="cc-crafting-list">
          {{#each craftingProjects as |project|}}
            <li class="cc-crafting-item {{#if project.complete}}complete{{/if}}">
              <div class="ci-head">
                <strong>{{project.name}}</strong>
                <span class="ci-meta">{{localize "CROWS.Sheet.Crow.crafting.meta" expertise=project.expertiseLabel required=project.prereqBonus goal=project.goal}}</span>
              </div>
              <div class="ci-bar"><div class="ci-bar-fill" style="width: {{project.pct}}%"></div></div>
              <div class="ci-row">
                <span class="ci-pts">{{localize "CROWS.Sheet.Crow.crafting.points" points=project.points goal=project.goal pct=project.pct}}</span>
                {{#if project.materials.length}}<span class="ci-mat">{{localize "CROWS.Sheet.Crow.crafting.materials"}}: {{#each project.materials}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>{{/if}}
                <button type="button" data-action="craftRoll" data-project-id="{{project.id}}" {{#if project.complete}}disabled{{/if}}>{{localize "CROWS.Sheet.Crow.crafting.roll"}}</button>
                {{#if project.complete}}<button type="button" data-action="craftComplete" data-project-id="{{project.id}}">{{localize "CROWS.Sheet.Crow.crafting.finalize"}}</button>{{/if}}
                <button type="button" data-action="craftCancel" data-project-id="{{project.id}}">{{localize "CROWS.Sheet.Crow.crafting.cancel"}}</button>
              </div>
              {{#if project.notes}}<div class="ci-notes">{{project.notes}}</div>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="cc-empty">{{localize "CROWS.Sheet.Crow.crafting.empty"}}</p>
      {{/if}}
    </div>
  </section>

  <section class="cc-tab cc-bio {{#if (eq activeTab 'bio')}}active{{/if}}"
           role="tabpanel" id="panel-bio" aria-labelledby="tab-bio"
           {{#unless (eq activeTab 'bio')}}hidden{{/unless}}>
    <div class="cc-creator-launch">
      <button type="button" data-action="openCreator" class="cc-creator-btn" data-tooltip="{{localize 'CROWS.Sheet.Crow.creator.hint'}}">
        <i class="fas fa-feather-pointed" aria-hidden="true"></i> {{localize "CROWS.Sheet.Crow.creator.open"}}
      </button>
      <span class="cc-creator-hint"><em>{{localize "CROWS.Sheet.Crow.creator.summary"}}</em></span>
    </div>
    <div class="cc-field"><label>{{localize "CROWS.Sheet.Crow.background"}}</label><input type="text" name="system.background" value="{{system.background}}"></div>
    <div class="cc-field"><label>{{localize "CROWS.Sheet.Crow.feature"}}</label><textarea name="system.details.feature" rows="6">{{system.details.feature}}</textarea></div>
    <div class="cc-field"><label>{{localize "CROWS.Sheet.Crow.cryptBoon"}}</label><input type="text" name="system.cryptBoon" value="{{system.cryptBoon}}"></div>
    <div class="cc-field"><label>{{localize "CROWS.Sheet.Crow.currency"}}</label><input type="number" name="system.currency" value="{{system.currency}}"></div>
    <div class="cc-section-title">{{localize "CROWS.Sheet.Crow.npcConnection.title"}}</div>
    <div class="cc-field"><label>{{localize "CROWS.Sheet.Crow.npcConnection.name"}}</label><input type="text" name="system.npcConnection.name" value="{{system.npcConnection.name}}"></div>
    <div class="cc-field"><label>{{localize "CROWS.Sheet.Crow.npcConnection.relationship"}}</label><input type="text" name="system.npcConnection.relationship" value="{{system.npcConnection.relationship}}"></div>
    <div class="cc-field"><label>{{localize "CROWS.Sheet.Crow.npcConnection.notes"}}</label><textarea name="system.npcConnection.notes" rows="4">{{system.npcConnection.notes}}</textarea></div>
  </section>
</div>
