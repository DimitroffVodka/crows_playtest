<div class="crows-crow">

  <header class="cc-header">
    <div class="cc-id">
      <div class="cc-field">
        <label>Name</label>
        <input type="text" name="name" value="{{actor.name}}">
      </div>
      <div class="cc-field">
        <label>Background</label>
        <input type="text" name="system.background" value="{{system.background}}">
      </div>
      <div class="cc-field feature">
        <label>Feature</label>
        <input type="text" name="system.details.feature" value="{{system.details.feature}}">
      </div>
    </div>
    <div class="cc-xp">
      <div class="cc-xp-row">
        <div class="cc-xp-cell"><label>Unspent XP</label><input type="number" name="system.xp.spendable" value="{{system.xp.spendable}}"></div>
        <div class="cc-xp-cell"><label>Next Advancement</label><span class="cc-xp-target">{{nextAdvancement}} TXP</span></div>
      </div>
      <div class="cc-xp-row">
        <div class="cc-xp-cell"><label>Total XP</label><input type="number" name="system.xp.txp" value="{{system.xp.txp}}"></div>
      </div>
    </div>
  </header>

  <section class="cc-stats">
    <div class="cc-stat-box clickable" data-action="rollChar" data-characteristic="strength" title="Roll Strength test">
      <div class="cc-stat-label">Strength</div>
      <input type="number" class="cc-stat-value" name="system.characteristics.strength.value" value="{{system.characteristics.strength.value}}">
    </div>
    <div class="cc-stat-box clickable" data-action="rollChar" data-characteristic="agility" title="Roll Agility test">
      <div class="cc-stat-label">Agility</div>
      <input type="number" class="cc-stat-value" name="system.characteristics.agility.value" value="{{system.characteristics.agility.value}}">
    </div>
    <div class="cc-stat-box clickable" data-action="rollChar" data-characteristic="mind" title="Roll Mind test">
      <div class="cc-stat-label">Mind</div>
      <input type="number" class="cc-stat-value" name="system.characteristics.mind.value" value="{{system.characteristics.mind.value}}">
    </div>
    <div class="cc-stat-box">
      <div class="cc-stat-label">Stamina</div>
      <div class="cc-stat-pair">
        <input type="number" name="system.stamina.value" value="{{system.stamina.value}}">
        <span class="sep">/</span>
        <input type="number" name="system.stamina.max" value="{{system.stamina.max}}">
      </div>
    </div>
    <div class="cc-stat-box">
      <div class="cc-stat-label">AD</div>
      <div class="cc-stat-value cc-ad-derived">{{system.ad}}</div>
    </div>
  </section>

  <section class="cc-substats">
    <div class="cc-mini-box" title="{{#if system.speedNote}}Reduced by {{system.speedNote}} (base {{system.speed}}){{/if}}">
      <div class="cc-mini-value">
        {{#if system.speedNote}}<span class="cc-speed-effective">{{system.effectiveSpeed}}</span><span class="cc-speed-base">/{{system.speed}}</span>{{else}}<input type="number" name="system.speed" value="{{system.speed}}">{{/if}}
      </div>
      <div class="cc-mini-label">Speed{{#if system.speedNote}} <em>({{system.speedNote}})</em>{{/if}}</div>
    </div>
    <div class="cc-mini-box">
      <div class="cc-mini-value">{{shift}}</div>
      <div class="cc-mini-label">Shift</div>
    </div>
    <div class="cc-conditions">
      <div class="cc-conditions-title">Conditions</div>
      <div class="cc-conditions-row">
        <div class="cc-cond-cell">
          <div class="cc-cond-label" id="cond-bb-label">Blessed/Boned</div>
          <div class="cc-cond-value" aria-labelledby="cond-bb-label">
            <span class="cc-net" aria-label="Net blessed minus boned">{{condNet}}</span>
            <button type="button" data-action="adjBlessed" data-delta="1" aria-label="Add 1 Blessed" title="+1 Blessed">+</button>
            <button type="button" data-action="adjBoned" data-delta="1" aria-label="Add 1 Boned" title="+1 Boned">&minus;</button>
          </div>
        </div>
        <div class="cc-cond-cell">
          <label class="cc-cond-label" for="cond-grabbed">Grabbed</label>
          <input id="cond-grabbed" type="checkbox" name="system.conditions.grabbed" {{#if condFlags.grabbed}}checked{{/if}} aria-label="Grabbed condition">
        </div>
        <div class="cc-cond-cell">
          <label class="cc-cond-label" for="cond-prone">Prone</label>
          <input id="cond-prone" type="checkbox" name="system.conditions.prone" {{#if condFlags.prone}}checked{{/if}} aria-label="Prone condition">
        </div>
        <div class="cc-cond-cell">
          <label class="cc-cond-label" for="cond-unconscious">Unconscious</label>
          <input id="cond-unconscious" type="checkbox" name="system.conditions.unconscious" {{#if condFlags.unconscious}}checked{{/if}} aria-label="Unconscious condition">
        </div>
      </div>
    </div>
    <div class="cc-time">
      <div class="cc-conditions-title">Time</div>
      <div class="cc-time-row">
        <div class="cc-time-cell">
          <div class="cc-cond-label">DT #</div>
          <div class="cc-net">{{dtCount}}</div>
        </div>
        <button type="button" data-action="takeRest" title="Take a 6h rest — full Stamina, -1 wound, restore spellbook UDs, encounter checks every 2h. Pick a rest activity in the dialog.">Rest…</button>
        {{#if isGM}}
          <button type="button" data-action="endDt" title="End Dungeon Turn — roll DT-expiry UDs, reset blessed/boned, encounter check (GM)">End DT</button>
          <button type="button" data-action="encounterCheck" title="Roll an ad-hoc encounter check (1d6 vs {{dungeonEN}}+) (GM)">Encounter</button>
        {{/if}}
      </div>
      {{#if system.preparedTask.skill}}
        <div class="cc-prepared-task" title="Prepare for Task: next {{system.preparedTask.skill}} test gets +1.">
          <strong>Prepared:</strong> +1 to next <em>{{system.preparedTask.skill}}</em>{{#if system.preparedTask.detail}} — {{system.preparedTask.detail}}{{/if}}
        </div>
      {{/if}}
      {{#if activeBoonCard}}
        <div class="cc-active-boon" title="Active Crypt boon — manage on the Downtime tab">
          <strong>{{activeBoonCard.label}}</strong>
          {{#if activeBoonCard.source}}<span class="cb-src">via {{activeBoonCard.source}}</span>{{/if}}
          {{#if (gte activeBoonCard.usesLeft 2)}}<span class="cb-uses">{{activeBoonCard.usesLeft}} uses</span>{{/if}}
          <div class="cb-summary">{{activeBoonCard.summary}}</div>
        </div>
      {{/if}}
      {{#if inMiasma}}
        <div class="cc-mini-flag" title="In the Miasma — see Downtime tab"><span class="cc-miasma-badge in-miasma" role="status">⚠ In Miasma</span>{{#if miasmaEffects.length}} <em>· {{miasmaEffects.length}} active effect{{#unless (eq miasmaEffects.length 1)}}s{{/unless}}</em>{{/if}}</div>
      {{/if}}
      {{#if miasmaPermanentNPC}}
        <div class="cc-mini-flag"><span class="cc-miasma-badge permanent-npc">PERMANENT NPC</span></div>
      {{/if}}
    </div>
  </section>

  <nav class="cc-tabs" role="tablist" aria-label="Character sheet tabs">
    {{#each tabs as |t|}}
      <button type="button" role="tab" data-action="switchTab" data-tab="{{t.id}}"
              id="tab-{{t.id}}"
              aria-controls="panel-{{t.id}}"
              aria-selected="{{#if (eq t.id ../activeTab)}}true{{else}}false{{/if}}"
              tabindex="{{#if (eq t.id ../activeTab)}}0{{else}}-1{{/if}}"
              class="{{#if (eq t.id ../activeTab)}}active{{/if}}">{{t.label}}</button>
    {{/each}}
  </nav>

  {{!-- MAIN TAB: Skills horizontal up top (3 columns: General/Spellcasting/Weapon), Perks below --}}
  <section class="cc-tab cc-main {{#if (eq activeTab 'main')}}active{{/if}}"
           role="tabpanel" id="panel-main" aria-labelledby="tab-main"
           {{#unless (eq activeTab 'main')}}hidden{{/unless}}>

    <div class="cc-skills cc-skills-horizontal">
      <div class="cc-section-title cc-skills-title">Skills</div>
      <div class="cc-skills-hint">Click name to roll · check <strong>+1</strong> / <strong>+2</strong> to set skill bonus</div>
      <div class="cc-skill-cols cc-skill-cols-tight">

        <div class="cc-skill-col cc-skill-col-general">
          <div class="cc-skill-group">General</div>
          <div class="cc-skill-grid-general">
            {{#each skillGroups.general as |s|}}
              <div class="cc-skill-row">
                <button type="button" class="cc-skill-name" data-action="rollSkill" data-skill="{{s.key}}" data-characteristic="{{s.char}}" title="Roll {{s.label}}">{{s.label}}</button>
                <input type="checkbox" data-action="toggleSkillBonus" data-skill="{{s.key}}" data-level="1" title="+1" {{#if (gte s.bonus 1)}}checked{{/if}}>
                <input type="checkbox" data-action="toggleSkillBonus" data-skill="{{s.key}}" data-level="2" title="+2" {{#if (gte s.bonus 2)}}checked{{/if}}>
              </div>
            {{/each}}
          </div>
        </div>

        <div class="cc-skill-col">
          <div class="cc-skill-group">Spellcasting</div>
          {{#each skillGroups.spellcasting as |s|}}
            <div class="cc-skill-row">
              <button type="button" class="cc-skill-name" data-action="rollSkill" data-skill="{{s.key}}" data-characteristic="{{s.char}}" title="Roll {{s.label}} (Mind)">{{s.label}}</button>
              <input type="checkbox" data-action="toggleSkillBonus" data-skill="{{s.key}}" data-level="1" title="+1" {{#if (gte s.bonus 1)}}checked{{/if}}>
              <input type="checkbox" data-action="toggleSkillBonus" data-skill="{{s.key}}" data-level="2" title="+2" {{#if (gte s.bonus 2)}}checked{{/if}}>
            </div>
          {{/each}}
        </div>

        <div class="cc-skill-col">
          <div class="cc-skill-group">Weapon</div>
          {{#each skillGroups.weapon as |s|}}
            <div class="cc-skill-row">
              <button type="button" class="cc-skill-name" data-action="rollSkill" data-skill="{{s.key}}" data-characteristic="{{s.char}}" title="Roll {{s.label}}">{{s.label}}</button>
              <input type="checkbox" data-action="toggleSkillBonus" data-skill="{{s.key}}" data-level="1" title="+1" {{#if (gte s.bonus 1)}}checked{{/if}}>
              <input type="checkbox" data-action="toggleSkillBonus" data-skill="{{s.key}}" data-level="2" title="+2" {{#if (gte s.bonus 2)}}checked{{/if}}>
            </div>
          {{/each}}
        </div>

      </div>
    </div>

    <div class="cc-perks">
      <div class="cc-section-title">Perks</div>
      <div class="cc-perks-list">
        {{#if perks.length}}
          {{#each perks as |p|}}
            <div class="cc-perk" data-action="openItem" data-item-id="{{p.id}}">
              <span class="cc-perk-name">{{p.name}}</span>
              <span class="cc-perk-meta">{{p.tree}} · t{{p.tier}}</span>
            </div>
          {{/each}}
        {{else}}
          <p class="cc-empty">No perks yet. Drag traits from the compendium onto this sheet.</p>
        {{/if}}
      </div>
    </div>

  </section>

  {{!-- EQUIPMENT TAB: 10 named slots, each renders item card inline --}}
  <section class="cc-tab cc-equipment {{#if (eq activeTab 'equipment')}}active{{/if}}"
           role="tabpanel" id="panel-equipment" aria-labelledby="tab-equipment"
           {{#unless (eq activeTab 'equipment')}}hidden{{/unless}}>
    <div class="cc-equip-grid">
      {{#each equipSlots as |s|}}
        <div class="cc-slot {{#if s.card}}filled{{/if}}" data-slot-id="{{s.id}}" data-container="{{s.container}}" data-index="{{s.index}}">
          <div class="cc-slot-header">{{s.label}}</div>
          {{#if s.card}}
            <div class="cc-card">
              <div class="cc-card-name" data-action="openItem" data-item-id="{{s.card.id}}" title="Open item sheet">
                {{s.card.name}}{{#if s.card.stack}} <span class="cc-card-stack">Stack {{s.card.stack}}</span>{{/if}}
              </div>
              {{#each s.card.summary.lines as |line|}}
                <div class="cc-card-line">{{line}}</div>
              {{/each}}
              {{#if (eq s.card.type "weapon")}}
                <button type="button" class="cc-attack-btn" data-action="attackWithWeapon" data-item-id="{{s.card.id}}" title="Roll attack with {{s.card.name}}">⚔ Attack</button>
              {{/if}}
              {{#if s.card.cost}}<div class="cc-card-cost">{{s.card.cost}} gc</div>{{/if}}
            </div>
          {{else}}
            <div class="cc-slot-empty">{{s.hint}}</div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- INVENTORY TAB: 10 backpack slots in 2x5 grid, wound checkbox per slot --}}
  <section class="cc-tab cc-inventory {{#if (eq activeTab 'inventory')}}active{{/if}}"
           role="tabpanel" id="panel-inventory" aria-labelledby="tab-inventory"
           {{#unless (eq activeTab 'inventory')}}hidden{{/unless}}>
    <div class="cc-wounds-controls">
      <span>Wounds: <strong>{{system.wounds}}</strong> / {{CROWS.backpackSize}}</span>
      <button type="button" data-action="adjWounds" data-delta="1">+ wound</button>
      <button type="button" data-action="adjWounds" data-delta="-1">- wound</button>
    </div>
    <div class="cc-inv-grid">
      {{#each backpack as |cell|}}
        <div class="cc-slot cc-inv-slot {{#if cell.card}}filled{{/if}} {{#if cell.isWound}}wound{{/if}}" data-container="backpack" data-index="{{cell.index}}">
          <div class="cc-slot-header">
            <span>Slot {{add cell.index 1}}</span>
            <label class="cc-wound-check"><span>Wound</span><input type="checkbox" {{#if cell.isWound}}checked{{/if}} disabled></label>
          </div>
          {{#if cell.isWound}}
            <div class="cc-slot-wound">&#10006; wound</div>
          {{else if cell.card}}
            <div class="cc-card" data-action="openItem" data-item-id="{{cell.card.id}}">
              <div class="cc-card-name">{{cell.card.name}}{{#if cell.card.stack}} <span class="cc-card-stack">Stack {{cell.card.stack}}</span>{{/if}}</div>
              {{#each cell.card.summary.lines as |line|}}
                <div class="cc-card-line">{{line}}</div>
              {{/each}}
              {{#if cell.card.cost}}<div class="cc-card-cost">{{cell.card.cost}} gc</div>{{/if}}
            </div>
          {{else}}
            <div class="cc-slot-empty">empty</div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- ADVANCEMENT TAB: XP, advancement-bonus tally, trait-tree purchase --}}
  <section class="cc-tab cc-advancement {{#if (eq activeTab 'advancement')}}active{{/if}}"
           role="tabpanel" id="panel-advancement" aria-labelledby="tab-advancement"
           {{#unless (eq activeTab 'advancement')}}hidden{{/unless}}>
    <div class="cc-adv-header">
      <div class="cc-adv-stat"><span class="cc-adv-label">TXP</span><strong>{{system.xp.txp}}</strong></div>
      <div class="cc-adv-stat"><span class="cc-adv-label">Spendable XP</span><strong>{{system.xp.spendable}}</strong></div>
      <div class="cc-adv-stat"><span class="cc-adv-label">Next bonus at</span><strong>{{nextBonusAt}} TXP</strong></div>
      <div class="cc-adv-stat"><span class="cc-adv-label">Skill/Stam bonuses</span><strong>{{bonusesEarned.skill}}</strong>{{#if bonusesAvailable.skill}}<span class="cc-adv-pending">{{bonusesAvailable.skill}} unspent</span>{{/if}}</div>
      <div class="cc-adv-stat"><span class="cc-adv-label">Characteristic adv.</span><strong>{{bonusesEarned.char}}</strong>{{#if bonusesAvailable.char}}<span class="cc-adv-pending">{{bonusesAvailable.char}} unspent</span>{{/if}}</div>
      {{#if bonusesAvailable.skill}}<button type="button" data-action="spendSkillBonus" class="cc-adv-spend-btn">Spend skill/stam</button>{{/if}}
      {{#if bonusesAvailable.char}}<button type="button" data-action="spendCharBonus" class="cc-adv-spend-btn">Spend char.</button>{{/if}}
      {{#if isGM}}
        <button type="button" data-action="grantXp" data-amount="100" class="cc-adv-grant">+100 XP</button>
        <button type="button" data-action="grantXp" data-amount="500" class="cc-adv-grant">+500 XP</button>
        <button type="button" data-action="grantXp" data-amount="1000" class="cc-adv-grant">+1000 XP</button>
      {{/if}}
    </div>

    <div class="cc-tree-picker">
      {{#each treeList as |t|}}
        <button type="button" data-action="selectTree" data-tree="{{t}}" class="cc-tree-chip {{#if (eq t ../selectedTree)}}active{{/if}}">{{t}}</button>
      {{/each}}
    </div>

    {{#if treeGrid}}
      <div class="cc-trait-grid">
        {{#each treeGrid as |row|}}
          <div class="cc-trait-row">
            <div class="cc-tier-label">
              <div class="ct-tier">Tier {{row.tier}}</div>
              <div class="ct-cost">{{row.cost}} XP</div>
            </div>
            {{#each row.cells as |cell|}}
              {{#if cell}}
                <div class="cc-trait-cell {{#if cell.owned}}owned{{else if cell.buyable}}buyable{{else}}locked{{/if}}"
                     {{#if cell.buyable}}data-action="buyTrait" data-trait-id="{{cell.id}}"{{/if}}
                     title="{{cell.reason}}">
                  <div class="ct-name">{{cell.name}}</div>
                  <div class="ct-status">
                    {{#if cell.owned}}<span class="ct-owned">✓ OWNED</span>
                    {{else if cell.buyable}}<span class="ct-buy">Buy ({{cell.cost}} XP)</span>
                    {{else}}<span class="ct-locked">🔒 locked</span>{{/if}}
                  </div>
                </div>
              {{else}}
                <div class="cc-trait-cell empty"><em>—</em></div>
              {{/if}}
            {{/each}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="cc-empty">Trait compendium not yet loaded.</p>
    {{/if}}
  </section>

  {{!-- DOWNTIME TAB: Village + Crypt boons + Miasma + Crafting projects --}}
  <section class="cc-tab cc-downtime {{#if (eq activeTab 'downtime')}}active{{/if}}"
           role="tabpanel" id="panel-downtime" aria-labelledby="tab-downtime"
           {{#unless (eq activeTab 'downtime')}}hidden{{/unless}}>

    {{!-- Village shell --}}
    {{#if village}}
      <div class="dt-panel dt-village">
        <header class="dt-panel-header">
          <strong>Village — {{village.name}}</strong>
          <span class="dt-village-stat" title="Prosperity (-10..+10)">Prosperity <strong>{{village.prosperity}}</strong></span>
          <span class="dt-village-stat" title="Village cycle (10 days each)">Cycle <strong>{{village.cycle}}</strong></span>
          <button type="button" data-action="openVillage" title="Manage village (institutions, prosperity, cycle, events)">Manage…</button>
        </header>
      </div>
    {{/if}}

    {{!-- Crypt --}}
    <div class="dt-panel dt-crypt">
      <header class="dt-panel-header">
        <strong>Crypt</strong>
        <span class="cc-crypt-label" title="Village Crypt institution level">L{{cryptLevel}}</span>
        <button type="button" data-action="cryptPray"
          {{#if alreadyPrayedThisCycle}}disabled title="Already prayed this cycle."
          {{else}}title="Pray at a dead crow's grave to receive their boon (once per cycle)."{{/if}}>
          Pray
        </button>
        {{#if activeBoonCard}}
          <button type="button" data-action="cryptExpend" title="Expend the active boon (free action).">Expend</button>
        {{/if}}
        {{#if isGM}}
          <button type="button" data-action="cryptInter" title="Inter this crow in the Crypt (pick a boon).">Inter (GM)</button>
          <button type="button" data-action="cryptBumpCycle" title="Advance the Village cycle (re-enables praying).">+Cycle (GM)</button>
        {{/if}}
      </header>
      {{#if activeBoonCard}}
        <div class="cc-active-boon" title="Active Crypt boon">
          <strong>{{activeBoonCard.label}}</strong>
          {{#if activeBoonCard.source}}<span class="cb-src">via {{activeBoonCard.source}}</span>{{/if}}
          {{#if (gte activeBoonCard.usesLeft 2)}}<span class="cb-uses">{{activeBoonCard.usesLeft}} uses</span>{{/if}}
          <div class="cb-summary">{{activeBoonCard.summary}}</div>
        </div>
      {{else}}
        <p class="cc-empty"><em>No active boon. Pray at a grave during the village cycle.</em></p>
      {{/if}}
    </div>

    {{!-- Miasma --}}
    <div class="dt-panel dt-miasma">
      <header class="dt-panel-header">
        <strong>Miasma</strong>
        {{#if inMiasma}}
          <span class="cc-miasma-badge in-miasma" title="The party is in the Miasma. Outdoor rests trigger a resist test.">In Miasma</span>
        {{else}}
          <span class="cc-miasma-badge clear" title="The party is currently not in the Miasma.">No Miasma</span>
        {{/if}}
        {{#if isGM}}
          <button type="button" data-action="toggleMiasma" title="Toggle the world-level Miasma flag (GM)">Toggle (GM)</button>
        {{/if}}
        <button type="button" data-action="rollMiasmaResist" title="Roll a 24h Miasma resist test (2d10 + M + Endurance)">Resist</button>
        {{#if miasmaEffects.length}}
          <button type="button" data-action="clearMiasmaSelf" title="Leave the Miasma — clears non-violence effects on this crow">Clear (leave)</button>
        {{/if}}
        {{#if miasmaPermanentNPC}}
          <span class="cc-miasma-badge permanent-npc" title="13+ catastrophic result — this PC is now a Ref-controlled NPC.">PERMANENT NPC</span>
        {{/if}}
      </header>
      {{#if miasmaEffects.length}}
        <ul class="cc-miasma-effects" title="Active Miasma effects on this crow">
          {{#each miasmaEffects as |e|}}
            <li><strong>{{e.label}}</strong> <span class="me-bucket">(d10+boned={{e.bucket}})</span> — {{e.text}}</li>
          {{/each}}
        </ul>
      {{else}}
        <p class="cc-empty"><em>No active Miasma effects.</em></p>
      {{/if}}
    </div>

    {{!-- Crafting --}}
    <div class="dt-panel dt-crafting">
      <header class="dt-panel-header">
        <strong>Crafting Projects</strong>
        <button type="button" data-action="craftStart" title="Start a new crafting project (skill prereq + materials + goal).">+ Start Project</button>
      </header>
      {{#if craftingProjects.length}}
        <ul class="cc-crafting-list">
          {{#each craftingProjects as |p|}}
            <li class="cc-crafting-item {{#if p.complete}}complete{{/if}}">
              <div class="ci-head">
                <strong>{{p.name}}</strong>
                <span class="ci-meta">{{p.skill}}+{{p.prereqBonus}} · goal {{p.goal}}</span>
              </div>
              <div class="ci-bar"><div class="ci-bar-fill" style="width: {{p.pct}}%"></div></div>
              <div class="ci-row">
                <span class="ci-pts">{{p.points}} / {{p.goal}} pts ({{p.pct}}%)</span>
                {{#if p.materials.length}}<span class="ci-mat">materials: {{#each p.materials}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>{{/if}}
                <button type="button" data-action="craftRoll" data-project-id="{{p.id}}" {{#if p.complete}}disabled{{/if}} title="Make a crafting roll (2d10 + M + skill).">Roll</button>
                {{#if p.complete}}<button type="button" data-action="craftComplete" data-project-id="{{p.id}}" title="Finalize the project — Ref grants the item.">Finalize</button>{{/if}}
                <button type="button" data-action="craftCancel" data-project-id="{{p.id}}" title="Cancel project (no materials expended).">Cancel</button>
              </div>
              {{#if p.notes}}<div class="ci-notes">{{p.notes}}</div>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="cc-empty">No active projects. Start one to begin crafting during rest activities.</p>
      {{/if}}
    </div>

  </section>

  {{!-- BIO TAB --}}
  <section class="cc-tab cc-bio {{#if (eq activeTab 'bio')}}active{{/if}}"
           role="tabpanel" id="panel-bio" aria-labelledby="tab-bio"
           {{#unless (eq activeTab 'bio')}}hidden{{/unless}}>
    <div class="cc-creator-launch">
      <button type="button" data-action="openCreator" class="cc-creator-btn" title="Walk through the character creator: roll/pick background, assign characteristics, name + feature.">
        🪶 Open Character Creator
      </button>
      <span class="cc-creator-hint"><em>For a fresh crow: rolls a background, applies skills/stamina/equipment/starting trait, and adds universal starter items.</em></span>
    </div>
    <div class="cc-field">
      <label>Background</label>
      <input type="text" name="system.background" value="{{system.background}}">
    </div>
    <div class="cc-field">
      <label>Feature</label>
      <textarea name="system.details.feature" rows="8">{{system.details.feature}}</textarea>
    </div>
    <div class="cc-field">
      <label>Crypt Boon</label>
      <input type="text" name="system.cryptBoon" value="{{system.cryptBoon}}">
    </div>
    <div class="cc-field">
      <label>Currency (gc)</label>
      <input type="number" name="system.currency" value="{{system.currency}}">
    </div>
  </section>
</div>
