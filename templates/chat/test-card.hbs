<div class="crows test-card tier-{{tier}}">
  <header class="band {{#if doom}}doom{{/if}} {{#if crit}}crit{{/if}}">
    <span class="band-label">{{bandLabel}}</span>
    {{#if doom}}<span class="badge doom">DOOM</span>{{/if}}
    {{#if crit}}<span class="badge crit">CRIT</span>{{/if}}
    {{#if tierForcedNote}}<span class="badge forced">tier-3 forced ({{tierForcedNote}})</span>{{/if}}
  </header>
  <div class="roll-line">
    <span class="roll-total">{{total}}</span>
    <span class="roll-detail">= 2d10({{rawSum}}){{#if char}} + {{char}} {{charVal}}{{/if}}{{#if skill}} + {{skill}} +{{skillBonus}}{{/if}}{{#each mods as |m|}} {{#if (gte m.value 0)}}+{{/if}}{{m.value}} ({{m.label}}){{/each}}</span>
  </div>
  {{#if attack}}
    <div class="damage">
      <button type="button" data-action="applyDamage" data-amount="{{attack.t2}}" data-piercing="{{#if attack.piercing}}true{{else}}false{{/if}}">Apply T2: {{attack.t2}}{{#if attack.piercing}} P{{/if}}</button>
      <button type="button" data-action="applyDamage" data-amount="{{attack.t3}}" data-piercing="{{#if attack.piercing}}true{{else}}false{{/if}}">Apply T3: {{attack.t3}}{{#if attack.piercing}} P{{/if}}</button>
    </div>
  {{/if}}
  {{#if casting}}<div class="casting-note">Casting: rank {{casting.rank}} {{casting.discipline}}</div>{{/if}}
</div>
