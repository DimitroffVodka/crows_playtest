{{!--
  systems/crows/templates/item/background.hbs
  Replaces the flat field list. Renders the printed item-card anatomy (see mockup 2a).

  ADAPTED from the design handoff to the real PT2 schema. Three of its
  assumptions were stale:

    * `system.characteristicBonus` does not exist. PT2 backgrounds SET one
      characteristic to 2 and some offer a CHOICE (C:28), so the field is
      `characteristicOptionsAt2` — an ARRAY. A single <select> cannot express
      it; this uses a multi-select and prints "or" between options.
    * `system.skills` does not exist either. Expertises are
      `[{key, uses}]`, so the "(2 uses)" the mockup wanted already works
      without the optional schema widening the handoff proposed.
    * Icons live in `icons/backgrounds/`, not `assets/icons/`, and come from
      four game-icons.net authors rather than Lorc alone — see NOTICE.md.

  Context comes from `backgroundSummary`, the same shaper the crow sheet's Bio
  tab uses, so the two surfaces cannot disagree about what a background grants.

  The name is a textarea, not an input, so long names wrap instead of clipping.
--}}
<form class="crows-item background" autocomplete="off">
  <article class="bg-card">

    <header class="bg-head">
      <div class="bg-titleline">
        <textarea name="name" class="bg-title" rows="1" spellcheck="false"
                  placeholder="{{localize "CROWS.Background.namePlaceholder"}}">{{item.name}}</textarea>
        <span class="bg-kind">{{localize "TYPES.Item.background"}}</span>
      </div>

      <div class="bg-origin">
        <div class="bg-glyph">
          <img src="{{item.img}}" alt="" data-edit="img">
        </div>
        <div class="bg-originbody">
          <div class="bg-action">{{localize "CROWS.Background.Origin"}}</div>
          <div class="bg-meta">
            <span>&#10231; {{localize "CROWS.Stamina"}}
              <input type="number" name="system.stamina" value="{{system.stamina}}" class="bg-num">
            </span>
            <span>&#9678; {{#if bg.characteristic.isAny}}{{localize "CROWS.Background.AnyCharacteristic"}}{{else}}{{bg.characteristic.labelText}}{{/if}}
              {{localize "CROWS.Background.AtTwo"}}
            </span>
          </div>
        </div>
      </div>

      <div class="bg-dice">&#9092; +
        {{#if bg.characteristic.initial}}<span class="bg-key">{{bg.characteristic.initial}}</span>{{bg.characteristic.rest}}{{else}}{{bg.characteristic.labelText}}{{/if}}
      </div>
    </header>

    <input type="text" name="system.flavor" value="{{system.flavor}}" class="bg-flavor"
           placeholder="{{localize "CROWS.Background.FlavorPlaceholder"}}">

    <section class="bg-note">
      <div class="bg-notelabel">{{localize "CROWS.Background.Expertises"}}</div>
      <p>{{#each bg.expertises as |e|}}{{e.label}}{{#if e.many}} <span class="bg-uses">({{e.uses}} {{localize "CROWS.Uses"}})</span>{{/if}}{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
    </section>

    <section class="bg-note">
      <div class="bg-notelabel">{{localize "CROWS.Background.Equipment"}}</div>
      <p>{{#each system.equipment as |e|}}{{e}}{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
      {{#if system.spellbooks.length}}
        <p class="bg-books">{{#each system.spellbooks as |sb|}}{{sb}}{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
      {{/if}}
    </section>

    {{!-- Coins and animals are their own fields now, so they can finally be
          SHOWN rather than hidden inside an equipment string. --}}
    {{#if bg.pets.length}}
      <section class="bg-note">
        <div class="bg-notelabel">{{localize "CROWS.Background.Pets"}}</div>
        <p>{{#each bg.pets as |p|}}{{p}}{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
      </section>
    {{/if}}

    <section class="bg-note">
      <div class="bg-notelabel">{{localize "CROWS.Background.Gold"}}</div>
      <p>{{#if bg.bonusGold}}{{localize "CROWS.Sheet.Crow.origin.goldBonus" formula=bg.startingGold bonus=bg.bonusGold}}{{else}}{{bg.startingGold}}{{/if}}</p>
    </section>

    {{#if system.startingTrait}}
      <section class="bg-note">
        <div class="bg-notelabel">{{localize "CROWS.Background.StartingTrait"}}</div>
        <p>{{system.startingTrait}}</p>
      </section>
    {{/if}}

    <div class="bg-foot"></div>
  </article>

  {{!-- everything not on the card face stays reachable, collapsed by default --}}
  <details class="bg-all">
    <summary>{{localize "CROWS.AllFields"}}</summary>
    <label>{{localize "CROWS.Background.StartingTrait"}}
      <input type="text" name="system.startingTrait" value="{{system.startingTrait}}">
    </label>
    <label>{{localize "CROWS.Background.CharacteristicOptions"}}
      <select name="system.characteristicOptionsAt2" multiple size="3">
        {{#each characteristicChoices as |c|}}
          <option value="{{c.key}}" {{#if c.selected}}selected{{/if}}>{{c.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize "CROWS.Background.Gold"}}
      <input type="text" name="system.startingGold" value="{{system.startingGold}}">
    </label>
    <label>{{localize "CROWS.Background.BonusGold"}}
      <input type="number" name="system.bonusGold" value="{{system.bonusGold}}" min="0" step="1">
    </label>
    <label>{{localize "CROWS.Description"}}
      <textarea name="system.description" rows="4">{{system.description}}</textarea>
    </label>
  </details>
</form>
