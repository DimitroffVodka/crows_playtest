{{!--
  systems/crows/templates/item/weapon.hbs
  Same printed-card anatomy as background.hbs and trait.hbs (see mockup 4a), plus the two
  parts only a weapon has: the dice/attack-stat line and the roll-tier table.

  ADAPTED. Read-only, like background.hbs and trait.hbs — weapons are shipped
  compendium content authored in src/packs/crows-weapons/*.yaml and rebuilt by
  `npm run pack`, so an edit here is discarded at the next build.

  `grip` is NOT in WeaponData; the context derives One hand / Two hands from
  `slots`, which cannot express the "Any" the Mace card prints. Adding the field
  is deferred — WeaponData is being edited concurrently for the enchantments
  array, and two agents in one file is how data gets lost.

  Needs, in order:
    1. css/crows-card-face.css appended to (or @imported by) css/crows.css
    2. css/crows-weapon.css after it
    3. the _prepareContext additions in handoff/README.md — this template expects
       `typeLabel`, `grip`, `rangeLine`, `attackStats`, `tiers`, `qualityLabels`,
       `physical` and `flavor` (enriched HTML)

  The frame is a TRIANGLE here, not the Background/Trait diamond — that is what the
  printed weapon cards use, and the glyph deliberately overhangs its lower-left edge.
--}}
<div class="crows-item card-face weapon" autocomplete="off">
  <article class="cf-card">

    <header class="cf-head">
      <div class="cf-titleline">
        <div class="cf-title">{{item.name}}</div>
        <span class="cf-kind">{{typeLabel}}</span>
      </div>

      <div class="cf-origin">
        {{!-- three layers: bone triangle, ink triangle inset inside it, glyph on top.
              Built from siblings rather than one clipped box, because a clip-path on the
              frame would cut off the part of the glyph that hangs outside it. --}}
        <div class="cf-glyph">
          <span class="wp-tri-out"></span>
          <span class="wp-tri-in"></span>
          <img src="{{item.img}}" alt="">
        </div>
        <div class="cf-originbody">
          <div class="cf-action">{{localize "CROWS.Weapon.Attack"}}</div>
          <div class="cf-meta">
            <span>&#10711; {{grip}}</span>
            <span>&#9678; {{{rangeLine}}}</span>
          </div>
        </div>
      </div>

      {{!-- the roll line. A Background never rolls, so its card has no equivalent. --}}
      <div class="cf-meta wp-dice">
        <span class="wp-die">&#9860;</span>
        <span>+ {{#each attackStats as |s|}}<span class="wp-box">{{s.initial}}</span>{{s.rest}}{{#unless @last}} {{localize "CROWS.Or"}} {{/unless}}{{/each}}</span>
      </div>
    </header>

    <div class="wp-tiers">
      {{#each tiers as |t|}}
        <div class="wp-row">
          <div class="wp-roll">{{{t.roll}}}</div>
          <div class="wp-result {{t.kind}}">{{#if t.damage}}<span class="wp-box">{{t.damage}}</span> {{localize "CROWS.Weapon.Dam"}}{{else}}{{t.text}}{{/if}}</div>
        </div>
      {{/each}}
    </div>

    {{#if flavor}}<div class="cf-rules wp-flavor">{{{flavor}}}</div>{{/if}}

    {{#if qualityLabels.length}}
      <section class="cf-note">
        <div class="cf-notelabel">{{localize "CROWS.Weapon.Qualities"}}</div>
        <p>{{#each qualityLabels as |q|}}{{q}}{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
      </section>
    {{/if}}

    <div class="cf-meta wp-physical">{{{physical}}}</div>
  </article>

  {{!-- everything not on the card face stays reachable, collapsed by default --}}
  </div>
