{{!-- Crows uses one side roll per round, never per-creature initiative. --}}
{{#if needsSideRoll}}
<div class="crows-side-roll" role="status">
    {{#if canRollSide}}
    <button type="button" class="combat-control combat-control-lg" data-action="rollSide"
            data-tooltip aria-label="{{ localize "CROWS.Combat.rollForRound" }}">
        <i class="fa-solid fa-dice-d10" inert></i>
        <span>{{ localize "CROWS.Combat.rollForRound" }}</span>
    </button>
    {{else}}
    <span>{{ localize "CROWS.Combat.notYetRolled" }}</span>
    {{/if}}
</div>
{{else if rolledThisRound}}
<div class="crows-side-roll" role="status">
    {{ localize "CROWS.Combat.sideRoll" roll=sideRoll side=firstSideLabel }}
</div>
{{/if}}

<ol class="combat-tracker plain">
{{#each groups}}
    <li class="crows-combat-side" data-side="{{ side }}">
        <h3 class="crows-combat-side-label">{{ label }}</h3>
        <ol class="plain">
        {{#each turns}}
        <li class="combatant crows-combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">
            {{!-- Image --}}
            <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

            {{!-- Name & Controls --}}
            <div class="token-name">
                <strong class="name">{{ name }}</strong>
                <div class="combatant-controls">
                    {{#if canReorder}}
                    {{#if canMoveUp}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-chevron-up"
                            data-action="moveCombatant" data-direction="up" data-tooltip
                            aria-label="{{ localize "CROWS.Combat.moveUp" }}"></button>
                    {{/if}}
                    {{#if canMoveDown}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-chevron-down"
                            data-action="moveCombatant" data-direction="down" data-tooltip
                            aria-label="{{ localize "CROWS.Combat.moveDown" }}"></button>
                    {{/if}}
                    {{/if}}

                    {{#if canToggleSurprised}}
                    {{#if surprised}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash active"
                            data-action="toggleSurprised" data-tooltip
                            aria-label="{{ localize "CROWS.Combat.markNotSurprised" }}"></button>
                    {{else}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-eye"
                            data-action="toggleSurprised" data-tooltip
                            aria-label="{{ localize "CROWS.Combat.markSurprised" }}"></button>
                    {{/if}}
                    {{/if}}

                    {{#if @root.user.isGM}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                            data-action="toggleHidden" data-tooltip aria-label="{{ localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide") }}"></button>
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                            data-action="toggleDefeated" data-tooltip
                            aria-label="{{ localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated") }}"></button>
                    {{/if}}
                    {{#if canPing}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                            data-action="pingCombatant" data-tooltip
                            aria-label="{{ localize "COMBATANT.Ping" }}"></button>
                    {{/if}}
                    {{#unless @root.user.isGM}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                            data-action="panToCombatant" data-tooltip
                            aria-label="{{ localize "COMBATANT.PanTo" }}"></button>
                    {{/unless}}
                    <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
                        {{#each effects.icons}}
                        <img class="token-effect" src="{{ img }}" alt="{{ name }}">
                        {{/each}}
                    </div>
                </div>
            </div>

            {{!-- Resource --}}
            {{#if resource includeZero=true}}
            <div class="token-resource">
                <span class="resource">{{ resource }}</span>
            </div>
            {{/if}}
        </li>
        {{/each}}
        </ol>
    </li>
{{/each}}
</ol>
